{
  "name": "specsfy",
  "version": "0.29.0",
  "description": "Install the Specsfy framework, run the spec lifecycle and its gates, and serve them to agents over MCP.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "bin": {
    "specsfy": "src/main.ts"
  },
  "termfy": {
    "bin": "specsfy",
    "title": "Specsfy",
    "author": "Promovaweb",
    "site": "https://promovaweb.com/docs/specsfy/cli/",
    "repository": "https://github.com/promovaweb/specsfy",
    "framework": "https://github.com/promovaweb/termfy",
    "starterKit": "0.9.2"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "tui": "bun run src/main.ts",
    "mcp": "bun run src/main.ts mcp",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "opencli": "bun run src/main.ts --opencli > docs/opencli.json",
    "opencli:check": "bun run scripts/check-opencli.ts",
    "skills:install": "npx -y skills add https://github.com/promovaweb/termfy -y -a universal -a claude-code -a codex -a opencode -a cursor -a gemini-cli",
    "skills:update": "npx -y skills update -y -p",
    "skills:check": "bun run scripts/check-skills.ts",
    "init": "bun run scripts/init.ts",
    "validate": "bun run embed:check && bun run launcher:check && bun run typecheck && bun test && bun run skills:check && bun run opencli:check && bun run docs:check && bun run build",
    "docs:check": "bun run scripts/check-docs.ts",
    "embed": "bun run scripts/embed-skills.ts",
    "embed:check": "bun run scripts/embed-skills.ts --check",
    "launcher": "bun run scripts/build-launcher.ts",
    "launcher:check": "bun run scripts/build-launcher.ts --check"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/specsfy.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "^0.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "skills": "1.5.22",
    "typescript": "^7.0.2"
  }
}
